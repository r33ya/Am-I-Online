# Copy to .env and edit. Used by docker-compose for the server on your NAS.

# Shared secret the bridge must present on POST /api/status.
# Generate: node -e "console.log(crypto.randomBytes(24).toString('hex'))"
STATUS_TOKEN=change-me-to-a-long-random-string

# No heartbeat for this many ms => the site shows "offline".
# Must be larger than the bridge's POLL_MS.
OFFLINE_AFTER_MS=15000

# Port the container listens on.
PORT=8787
