# Copy to .env and edit. Read automatically by agent.js.

# Your NAS server's WebSocket endpoint.
STATUS_WS_URL=ws://YOUR-NAS-IP:8787/ws
STATUS_TOKEN=same-value-as-the-server

# How this computer appears on the page.
DEVICE_ID=desktop
DEVICE_NAME=My Computer

# Folia desktop Stage API.
#   Settings -> Connections & Integrations -> Stage Mode -> source = Stage API
FOLIA_STAGE_URL=http://127.0.0.1:32107
FOLIA_STAGE_TOKEN=paste-the-token-from-folia

# Folia desktop lyric API (read-only, no token).
#   Settings -> Connections & Integrations -> Lyric API -> enable
FOLIA_LYRIC_URL=http://127.0.0.1:32109/v1/lyric

# How often to sample Folia and send a heartbeat, in milliseconds.
POLL_MS=5000

# Set to 1 to print the raw player status once (to verify field names).
LOG_RAW=0
